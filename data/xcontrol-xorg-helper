#!/bin/sh
# xcontrol-xorg-helper: XControl's X server settings (runs as root via pkexec).
#
#   write XDRIVER [pick:KERNELDRIVER:XDRIVER:BUSID ...] [drv:KERNELDRIVER:OPTION=VALUE ...] [srv:OPTION=VALUE ...]
#
#     /etc/X11/xorg.conf.d/30-xcontrol.conf: one OutputClass section per kernel driver
#     (MatchDriver; X applies its options to the X driver on that GPU; read late, so they win
#     over earlier classes) and a ServerFlags section. Removed when there are no options.
#     /etc/X11/xorg.conf.d/00-xcontrol-driver.conf: a Device section per GPU whose X driver is
#     picked (Driver, and BusID such as PCI:48:0:0, or - for none). X uses the first Device
#     section it reads for its screen instead of guessing a driver (an OutputClass Driver line
#     can't do that: the drivers' own classes in /usr/share/X11/xorg.conf.d come first).
#     Removed when nothing is picked. The X driver must be installed (its *_drv.so in an X
#     module folder), or it's refused. Only these two files are ever touched.
#     XDRIVER is the X driver the options were chosen for (a comment, so XControl can tell).
#     fix:modulepath gives each OutputClass an empty ModulePath: XLibre 25.1 crashes on an
#     OutputClass with neither Driver, Modules nor ModulePath; "" keeps the standard path.
#
# Names and values are validated strictly: letters, digits and _ for names; values may also
# have . , : + - and nothing else (no spaces, quotes or shell characters).
set -eu

die() { echo "xcontrol-xorg-helper: $*" >&2; exit 1; }

DIR=/etc/X11/xorg.conf.d
MODULES="/usr/lib/xorg/modules /usr/lib64/xorg/modules /usr/local/lib/xorg/modules"
if [ "$(id -u)" != 0 ]; then   # test hooks, ignored when running as root
    DIR=${XCONTROL_XORG_DIR:-$DIR}
    MODULES=${XCONTROL_XMODULES:-$MODULES}
fi
FILE=$DIR/30-xcontrol.conf
DFILE=$DIR/00-xcontrol-driver.conf

installed() {   # an X video driver's module exists (in a module folder, or one level down: xlibre-25)
    for root in $MODULES; do
        for f in "$root/drivers/$1_drv.so" "$root"/*/drivers/"$1_drv.so"; do
            [ -f "$f" ] && return 0
        done
    done
    return 1
}

[ $# -ge 2 ] || die "usage: write XDRIVER [pick:...] [drv:...] [srv:...]"
[ "$1" = write ] || die "unknown command: $1"
xdriver=$2
shift 2
case $xdriver in -) ;; ''|*[!a-z0-9_-]*) die "invalid X driver: $xdriver";; esac
[ ${#xdriver} -le 32 ] || die "invalid X driver: $xdriver"
[ $# -le 64 ] || die "too many options"

check_name() {
    case $1 in ''|*[!a-z0-9_-]*) die "invalid name: $1";; esac
    [ ${#1} -le 32 ] || die "name too long: $1"
}
check_opt() {   # NAME=VALUE
    name=${1%%=*}
    value=${1#*=}
    [ "$name" != "$1" ] || die "expected OPTION=VALUE: $1"
    case $name in [A-Za-z]*) ;; *) die "invalid option name: $name";; esac
    case $name in *[!A-Za-z0-9_]*) die "invalid option name: $name";; esac
    [ ${#name} -le 48 ] || die "invalid option name: $name"
    case $value in *[!A-Za-z0-9_.,:+-]*) die "invalid value for $name: $value";; esac
    [ ${#value} -le 128 ] || die "value too long for $name"
}

drivers=""
npicks=0
nopts=0
mpfix=0
for a in "$@"; do
    case $a in
        fix:modulepath) mpfix=1;;
        pick:*:*:*)
            rest=${a#pick:}
            kd=${rest%%:*}; rest=${rest#*:}
            xd=${rest%%:*}; bus=${rest#*:}
            check_name "$kd"
            check_name "$xd"
            case $bus in
                -) ;;
                PCI:*) b=${bus#PCI:}
                       case $b in *[!0-9:@]*|'') die "invalid BusID: $bus";; esac
                       [ ${#b} -le 16 ] || die "invalid BusID: $bus";;
                *) die "invalid BusID: $bus";;
            esac
            installed "$xd" || die "the $xd X driver isn't installed"
            npicks=$((npicks + 1))
            ;;
        drv:*:*=*)
            rest=${a#drv:}
            kd=${rest%%:*}
            check_name "$kd"
            check_opt "${rest#*:}"
            case " $drivers " in *" $kd "*) ;; *) drivers="$drivers $kd";; esac
            nopts=$((nopts + 1))
            ;;
        srv:*=*) check_opt "${a#srv:}"; nopts=$((nopts + 1));;
        *) die "invalid argument: $a";;
    esac
done

mkdir -p "$DIR"

# the driver file
if [ $npicks -eq 0 ]; then
    rm -f "$DFILE"
else
    tmp=$DFILE.tmp
    {
        echo "# Written by XControl (System > X server): the X driver for each GPU. Delete this file to"
        echo "# go back to the automatic choice."
        for a in "$@"; do
            case $a in
                pick:*)
                    rest=${a#pick:}
                    kd=${rest%%:*}; rest=${rest#*:}
                    xd=${rest%%:*}; bus=${rest#*:}
                    echo
                    echo 'Section "Device"'
                    echo "    Identifier \"XControl: $kd\""
                    echo "    Driver \"$xd\""
                    [ "$bus" = - ] || echo "    BusID \"$bus\""
                    echo "EndSection"
                    ;;
            esac
        done
    } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$DFILE"
fi

# the options file
if [ $nopts -eq 0 ]; then
    rm -f "$FILE"
    echo "saved"
    exit 0
fi
tmp=$FILE.tmp
{
    echo "# Written by XControl (System > X server). Delete this file to undo everything here."
    echo "# for the X driver: $xdriver"
    for kd in $drivers; do
        echo
        echo 'Section "OutputClass"'
        echo "    Identifier \"XControl: $kd\""
        echo "    MatchDriver \"$kd\""
        [ $mpfix = 0 ] || echo '    ModulePath ""'
        for a in "$@"; do
            case $a in
                drv:"$kd":*) o=${a#drv:"$kd":}; echo "    Option \"${o%%=*}\" \"${o#*=}\"";;
            esac
        done
        echo "EndSection"
    done
    first=1
    for a in "$@"; do
        case $a in
            srv:*)
                if [ $first = 1 ]; then echo; echo 'Section "ServerFlags"'; first=0; fi
                o=${a#srv:}
                echo "    Option \"${o%%=*}\" \"${o#*=}\""
                ;;
        esac
    done
    [ $first = 1 ] || echo "EndSection"
} > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$FILE"
echo "saved"
