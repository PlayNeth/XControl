<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- XControl's root helpers. Asking once is enough for a few minutes (auth_admin_keep),
     so changing several settings in a row doesn't ask for the password every time. -->
<policyconfig>
  <vendor>XControl</vendor>
  <action id="io.github.xcontrol.edid">
    <description>Install or test a display's EDID override</description>
    <message>Authentication is required to change how the kernel sees your display</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-edid-helper</annotate>
  </action>
  <action id="io.github.xcontrol.modules">
    <description>Set kernel module parameters</description>
    <message>Authentication is required to change kernel module parameters</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-module-helper</annotate>
  </action>
  <action id="io.github.xcontrol.users">
    <description>Manage user accounts</description>
    <message>Authentication is required to change user accounts</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-user-helper</annotate>
  </action>
  <action id="io.github.xcontrol.locales">
    <description>Make languages available</description>
    <message>Authentication is required to add languages to this computer</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-locale-helper</annotate>
  </action>
  <action id="io.github.xcontrol.power">
    <description>Change what the power and sleep buttons do</description>
    <message>Authentication is required to change what the power buttons and the lid do</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-power-helper</annotate>
  </action>
  <action id="io.github.xcontrol.controllers">
    <description>Change the USB polling rate of game controllers</description>
    <message>Authentication is required to change how often USB game controllers are read</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-controller-helper</annotate>
  </action>
  <action id="io.github.xcontrol.controllers.hide">
    <description>Hide a game controller from other programs</description>
    <message>Authentication is required to hide a game controller from other programs</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-controller-hide</annotate>
  </action>
  <action id="io.github.xcontrol.xorg">
    <description>Change the X server's options</description>
    <message>Authentication is required to change the X server's options</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/xcontrol-xorg-helper</annotate>
  </action>
</policyconfig>
