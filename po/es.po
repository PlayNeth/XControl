msgstr "Opciones de {driver}"

#: xcontrol/xserver_page.py:558
#, python-brace-format
msgid ""
"For the whole X server. Saved in {file}; they take effect the next time X "
"starts."
msgstr ""
"Para todo el servidor X. Se guardan en {file}; surten efecto la próxima vez "
"que se inicie X."

#: xcontrol/xserver_page.py:576
msgid "Saved; X uses it the next time it starts"
msgstr "Guardado; X lo usará la próxima vez que se inicie"

#: xcontrol/xserver_page.py:579
