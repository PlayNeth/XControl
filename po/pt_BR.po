msgstr "Não havia nada para desativar."

#: xcontrol/appearance_page.py:383
#, python-brace-format
msgid "Linked into your home folder: {items}. Restart the app."
msgstr "Links criados na sua pasta pessoal: {items}. Reinicie o aplicativo."

#: xcontrol/appearance_page.py:384
msgid "The themes are already in your home folder."
msgstr "Os temas já estão na sua pasta pessoal."

#: xcontrol/appearance_page.py:387
