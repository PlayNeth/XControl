#: mesa_panel/resolutions_dialog.py:86
msgid ""
"Hides every other mode: the ones the display reports in its EDID and the "
"scaled modes some drivers add (modesetting does this on connectors that "
"support scaling). Custom resolutions are re-created automatically when you "
"log in or open this panel."
msgstr ""
"Oculta todos os outros modos: os que a tela informa no EDID e os modos "
"escalados que alguns drivers adicionam (o modesetting faz isso em conectores"
" com suporte a escala). As resoluções personalizadas são recriadas "
"automaticamente quando você inicia a sessão ou abre este painel."

#: mesa_panel/resolutions_dialog.py:92
msgid "My resolutions"
msgstr "Minhas resoluções"

#: mesa_panel/resolutions_dialog.py:102
msgid "Add a resolution"
msgstr "Adicionar uma resolução"

#: mesa_panel/resolutions_dialog.py:119
msgid "Classic modes"
msgstr "Modos clássicos"

#: mesa_panel/resolutions_dialog.py:135
msgid "Timing"
msgstr "Temporização"

#: mesa_panel/resolutions_dialog.py:139
msgid "Paste a modeline, e.g. from the cvt or gtf tools or an old xorg.conf"
msgstr ""
"Cole uma modeline, por exemplo das ferramentas cvt ou gtf ou de um xorg.conf"
" antigo"

#: mesa_panel/resolutions_dialog.py:140
msgid "Modeline"
msgstr "Modeline"

#: mesa_panel/resolutions_dialog.py:159
msgid "For all programs"
msgstr "Para todos os programas"

#: mesa_panel/resolutions_dialog.py:162
msgid ""
"The options above only change what this panel offers. To hide unwanted modes"
" from games and every other program, give the kernel a corrected EDID."
msgstr ""
"As opções acima só mudam o que este painel oferece. Para esconder modos "
"indesejados dos jogos e de todos os outros programas, forneça ao kernel um "
"EDID corrigido."

#: mesa_panel/resolutions_dialog.py:164
msgid "System-wide mode list…"
msgstr "Lista de modos do sistema…"

#: mesa_panel/resolutions_dialog.py:223
msgid "No custom resolutions yet."
msgstr "Nenhuma resolução personalizada ainda."

#: mesa_panel/resolutions_dialog.py:240
msgid "Remove"
msgstr "Remover"

#: mesa_panel/resolutions_dialog.py:258
#, python-brace-format
msgid "VESA DMT has no timing for {w} × {h}. Pick another timing standard."
msgstr ""
"O VESA DMT não tem temporização para {w} × {h}. Escolha outro padrão de "
"temporização."

#: mesa_panel/resolutions_dialog.py:275
#, python-brace-format
msgid "Pixel clock {clock} MHz · horizontal {hfreq} kHz · refresh {hz} Hz"
msgstr ""
"Clock de pixel {clock} MHz · horizontal {hfreq} kHz · atualização {hz} Hz"

#: mesa_panel/resolutions_dialog.py:279
msgid ""
"Below 25 MHz: HDMI links usually refuse this. Use DMT or a higher refresh "
"rate."
msgstr ""
"Abaixo de 25 MHz: conexões HDMI costumam recusar isto. Use DMT ou uma taxa "
"de atualização maior."

#: mesa_panel/resolutions_dialog.py:282
#, python-brace-format
msgid ""
"Outside the {low}–{high} Hz range the display reports; it may show no "
"picture."
msgstr ""
"Fora da faixa de {low}–{high} Hz que a tela informa; ela pode ficar sem "
"imagem."

#: mesa_panel/resolutions_dialog.py:285
#, python-brace-format
msgid "Above the display's reported maximum pixel clock ({clock} MHz)."
msgstr "Acima do clock de pixel máximo informado pela tela ({clock} MHz)."

#: mesa_panel/resolutions_dialog.py:301
msgid "That resolution is already in the list"
msgstr "Essa resolução já está na lista"

#: mesa_panel/resolutions_dialog.py:307
msgid "xrandr could not add this resolution"
msgstr "O xrandr não conseguiu adicionar esta resolução"

#: mesa_panel/resolutions_dialog.py:311
msgid "The X server did not keep this resolution"
msgstr "O servidor X não manteve esta resolução"

#: mesa_panel/resolutions_dialog.py:312
#, python-brace-format
msgid ""
"xrandr accepted {mode}, but it is not in the mode list of {output}. The "
"display driver may have rejected it."
msgstr ""
"O xrandr aceitou {mode}, mas ele não está na lista de modos de {output}. O "
"driver de vídeo pode tê-lo recusado."

#: mesa_panel/resolutions_dialog.py:318
msgid "Resolution added. Pick it on the Displays page and press Apply."
msgstr "Resolução adicionada. Escolha-a na página Telas e clique em Aplicar."

#: mesa_panel/resolutions_dialog.py:322
msgid "This resolution is in use"
msgstr "Esta resolução está em uso"

#: mesa_panel/resolutions_dialog.py:323
msgid "Switch the display to another resolution before removing it."
msgstr "Mude a tela para outra resolução antes de removê-la."

