#, python-brace-format
msgid "{px} px"
msgstr "{px} px"

#: xcontrol/appearance_page.py:125
msgid "Size"
msgstr "Tamanho"

#: xcontrol/appearance_page.py:127
msgid "Cursor theme"
msgstr "Tema do cursor"

#: xcontrol/appearance_page.py:128
msgid ""
"i3 and other window managers load the cursor when they start; restart them "
"(i3: Mod+Shift+R) to see it on the desktop and window borders."
msgstr ""
"O i3 e outros gerenciadores de janelas carregam o cursor ao iniciar; "
"reinicie-os (i3: Mod+Shift+R) para vê-lo na área de trabalho e nas bordas "
"das janelas."

#: xcontrol/appearance_page.py:133
msgid "Fonts"
msgstr "Fontes"

#: xcontrol/appearance_page.py:137
msgid "Smooth edges (antialiasing)"
msgstr "Suavizar bordas (antialiasing)"

#: xcontrol/appearance_page.py:147
msgid "Interface font"
msgstr "Fonte da interface"

#: xcontrol/appearance_page.py:148
msgid "Hinting"
msgstr "Hinting"

#: xcontrol/appearance_page.py:148
msgid "Subpixel order"
msgstr "Ordem dos subpixels"

#: xcontrol/appearance_page.py:153
msgid "Also set the icon theme and font for Qt apps (qt5ct/qt6ct)"
msgstr ""
"Aplicar também o tema de ícones e a fonte aos aplicativos Qt (qt5ct/qt6ct)"

#: xcontrol/appearance_page.py:157 xcontrol/appearance_page.py:163
msgid "Qt applications"
msgstr "Aplicativos Qt"

#: xcontrol/appearance_page.py:158
#, python-brace-format
msgid ""
"Qt apps take their colors, icons and font from the GTK settings above, "
"because QT_QPA_PLATFORMTHEME={value}. Nothing else is needed."
msgstr ""
"Os aplicativos Qt pegam cores, ícones e fonte das configurações GTK acima, "
"porque QT_QPA_PLATFORMTHEME={value}. Não é preciso mais nada."

#: xcontrol/appearance_page.py:164
#, python-brace-format
msgid "Qt apps follow this because QT_QPA_PLATFORMTHEME={value}."
msgstr "Os aplicativos Qt seguem isto porque QT_QPA_PLATFORMTHEME={value}."

#: xcontrol/appearance_page.py:166
msgid ""
"Qt apps only use these settings when QT_QPA_PLATFORMTHEME=qt5ct (or qt6ct) "
"is set in your session, e.g. in ~/.xprofile. It isn't set now."
msgstr ""
"Aplicativos Qt só usam estas configurações quando QT_QPA_PLATFORMTHEME=qt5ct"
" (ou qt6ct) está definido na sessão, por exemplo em ~/.xprofile. No momento "
"não está."

#: xcontrol/appearance_page.py:175 xcontrol/display_page.py:614
msgid "Revert"
msgstr "Reverter"

#: xcontrol/appearance_page.py:178 xcontrol/display_page.py:262
#: xcontrol/input_page.py:212
msgid "Apply"
msgstr "Aplicar"

#: xcontrol/appearance_page.py:183
msgid ""
"Changes are previewed in this window. Apply sets them for GTK 2, 3 and 4, X "
"cursors, libadwaita's dark preference and Qt, and updates open apps."
msgstr ""
"As mudanças são pré-visualizadas nesta janela. Aplicar define tudo para GTK "
"2, 3 e 4, cursores do X, preferência escura da libadwaita e Qt, e atualiza "
"os aplicativos abertos."

#: xcontrol/appearance_page.py:188
msgid "An app ignores the theme?"
msgstr "Um aplicativo ignora o tema?"

#: xcontrol/appearance_page.py:189 xcontrol/appearance_page.py:342
msgid "Check an app…"
msgstr "Verificar um aplicativo…"

#: xcontrol/appearance_page.py:192
msgid ""
"Click the button, then click the app's window. XControl looks at how the app"
" runs and tells you why it doesn't follow the theme."
msgstr ""
"Clique no botão e depois na janela do aplicativo. O XControl examina como "
"ele roda e explica por que ele não segue o tema."

#: xcontrol/appearance_page.py:247
msgid ""
"This theme isn't in any theme folder (it may be built into a program), so "
"other apps probably can't find it. Pick one from the list."
msgstr ""
"Este tema não está em nenhuma pasta de temas (pode estar embutido em algum "
"programa), então outros aplicativos provavelmente não o encontram. Escolha "
"um da lista."

#: xcontrol/appearance_page.py:251
#, python-brace-format
msgid ""
"This theme has no version for {kits}; apps using those keep their default "
"look."
msgstr ""
"Este tema não tem versão para {kits}; aplicativos que usam esses mantêm a "
"aparência padrão."

#: xcontrol/appearance_page.py:259
msgid "Open apps update right away (xsettingsd is running)."
msgstr ""
"Os aplicativos abertos são atualizados na hora (o xsettingsd está rodando)."

#: xcontrol/appearance_page.py:261
msgid "Open apps update right away through your desktop's settings service."
msgstr ""
"Os aplicativos abertos são atualizados na hora pelo serviço de configurações"
" do seu ambiente."

#: xcontrol/appearance_page.py:263
msgid ""
"Another program manages live settings; open apps may only update after a "
"restart."
msgstr ""
"Outro programa gerencia as configurações ao vivo; os aplicativos abertos "
"talvez só atualizem depois de reiniciados."

#: xcontrol/appearance_page.py:265
msgid ""
"Apply starts xsettingsd (and adds it to your login), so open apps update "
"right away."
msgstr ""
"Aplicar inicia o xsettingsd (e o adiciona ao login), para que os aplicativos"
" abertos atualizem na hora."

#: xcontrol/appearance_page.py:267
msgid ""
"Install xsettingsd so open apps update right away; until then they pick up "
"changes when they restart."
msgstr ""
"Instale o xsettingsd para que os aplicativos abertos atualizem na hora; até "
"lá, eles pegam as mudanças quando reiniciam."

#: xcontrol/appearance_page.py:290
msgid "Previewing here; press Apply to use it everywhere"
msgstr "Pré-visualizando aqui; clique em Aplicar para usar em todo lugar"

#: xcontrol/appearance_page.py:310
msgid "Back to the current settings"
msgstr "De volta às configurações atuais"

#: xcontrol/appearance_page.py:317
msgid "Could not apply the appearance settings"
msgstr "Não foi possível aplicar as configurações de aparência"

#: xcontrol/appearance_page.py:322
msgid "Applied; open apps are updating"
msgstr "Aplicado; os aplicativos abertos estão atualizando"

#: xcontrol/appearance_page.py:324
msgid "Applied; open apps update when they restart"
msgstr "Aplicado; os aplicativos abertos atualizam quando reiniciarem"

#: xcontrol/appearance_page.py:329
msgid "Click the app's window…"
msgstr "Clique na janela do aplicativo…"

#: xcontrol/appearance_page.py:344
msgid "xprop is needed for this (package xorg-xprop)."
msgstr "É preciso o xprop para isso (pacote xorg-xprop)."

#: xcontrol/appearance_page.py:345
msgid "That window doesn't say which program it belongs to."
msgstr "Essa janela não informa a qual programa pertence."

#: xcontrol/appearance_page.py:346
msgid "No window was clicked."
msgstr "Nenhuma janela foi clicada."

#: xcontrol/appearance_page.py:347
msgid "Couldn't check the app"
msgstr "Não foi possível verificar o aplicativo"

#: xcontrol/appearance_page.py:349
#, python-brace-format
msgid "Why {app} looks different"
msgstr "Por que {app} está com outra aparência"

#: xcontrol/appearance_page.py:355
