#. (off)"
#: mesa_panel/xrandr.py:50
#, python-brace-format
msgid "{output} (off)"
msgstr "{output} (desligada)"

#: mesa_panel/xrandr.py:62
msgid "The xrandr command was not found. Install the xorg-xrandr package."
msgstr "O comando xrandr não foi encontrado. Instale o pacote xorg-xrandr."

#: mesa_panel/xrandr.py:65
msgid ""
"You are in a Wayland session. xrandr only controls X11 outputs, so use your "
"desktop's display settings here."
msgstr ""
"Você está em uma sessão Wayland. O xrandr só controla saídas X11, então use "
"aqui as configurações de tela do seu ambiente gráfico."

#: mesa_panel/xrandr.py:68
msgid "No X11 display found (DISPLAY is not set)."
msgstr "Nenhuma tela X11 encontrada (DISPLAY não está definido)."

