msgstr "Total (mais nítido, altera o formato das letras)"

#: xcontrol/appearance_page.py:19
msgid "Off (grayscale; for CRTs, projectors, rotated screens)"
msgstr "Desligado (tons de cinza; para CRTs, projetores, telas giradas)"

#: xcontrol/appearance_page.py:20
